    "value-props": {
      "type": "value-props",
      "settings": {
        "eyebrow": "What you're actually buying",
        "heading": "You're not buying a video.",
        "heading_accent": "You're skipping the production."
      },
      "blocks": {
        "p1": {
          "type": "prop",
          "settings": {
            "icon": "shield",
            "icon_color": "green",
            "title": "No production to pay for",
            "body": "<p>No agency, no production company, no studio, no camera gear, no actors, no travel days. The cost of shooting an ad disappears from your budget.</p>"
          }
        },
        "p2": {
          "type": "prop",
          "settings": {
            "icon": "bolt",
            "icon_color": "violet",
            "title": "More variants, less time",
            "body": "<p>A traditional shoot gives you one idea per production day. Here you test several angles in the time it used to take to book a studio.</p>"
          }
        },
        "p3": {
          "type": "prop",
          "settings": {
            "icon": "sparkle",
            "icon_color": "cyan",
            "title": "A person directs it",
            "body": "<p>Not a prompt box. Someone who has run paid ads decides the angle, the hook and the edit — then uses AI to produce it.</p>"
          }
        },
        "p4": {
          "type": "prop",
          "settings": {
            "icon": "layers",
            "icon_color": "green",
            "title": "Works at any size",
            "body": "<p>Small brands get started without hiring an agency. Bigger teams multiply their creative output without multiplying their infrastructure.</p>"
          }
        }
      },
      "block_order": [
        "p1",
        "p2",
        "p3",
        "p4"
      ]
