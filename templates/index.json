    "problems": {
      "type": "problem-grid",
      "settings": {
        "eyebrow": "The problem we solve",
        "heading": "Creative production shouldn't",
        "heading_accent": "slow down your campaigns",
        "body": "Most teams don't lose money on media buying. They lose it waiting on creative.",
        "align": "left",
        "solution_text": "QuickMotion gives your team a production system that keeps up with how fast you need to test.",
        "cta_label": "See our work",
        "cta_url": "/pages/portfolio"
      },
      "blocks": {
        "pb1": {
          "type": "problem",
          "settings": {
            "title": "Traditional production is slow",
            "body": "<p>Weeks from concept to final delivery. By the time the creative lands, the campaign has already been waiting on it.</p>"
          }
        },
        "pb2": {
          "type": "problem",
          "settings": {
            "title": "Freelancers are difficult to manage",
            "body": "<p>Multiple people, inconsistent quality, endless communication. Coordination becomes its own job.</p>"
          }
        },
        "pb3": {
          "type": "problem",
          "settings": {
            "title": "Testing requires more creative volume",
            "body": "<p>Winning campaigns come from testing multiple hooks, angles, concepts and formats — not from one polished video.</p>"
          }
        },
        "pb4": {
          "type": "problem",
          "settings": {
            "title": "In-house production doesn't always scale",
            "body": "<p>Creative demand grows faster than internal teams. Hiring more editors is slow and expensive to reverse.</p>"
          }
        }
      },
      "block_order": ["pb1", "pb2", "pb3", "pb4"]
    },
