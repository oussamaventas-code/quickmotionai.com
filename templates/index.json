    "how-it-works": {
      "type": "how-it-works",
      "settings": {
        "eyebrow": "How it works",
        "heading": "Human judgement first.",
        "heading_accent": "AI does the producing.",
        "body": "AI lowers the cost of producing. The person brings the idea, the strategy and the criteria to know what will actually sell."
      },
      "blocks": {
        "st1": {
          "type": "step",
          "settings": {
            "title": "Idea and strategy",
            "meta": "10-minute brief",
            "body": "<p>You tell us the product and who it's for. We decide the sales angle worth testing — that call is made by a person, not a model.</p>"
          }
        },
        "st2": {
          "type": "step",
          "settings": {
            "title": "Creative direction",
            "meta": "Before anything is generated",
            "body": "<p>Hook, script, pacing and format are written and directed first. This is the part that decides whether an ad works.</p>"
          }
        },
        "st3": {
          "type": "step",
          "settings": {
            "title": "AI production",
            "meta": "No shoot required",
            "body": "<p>The footage is produced with AI instead of a camera crew. That's where the cost and the calendar of a traditional shoot disappear.</p>"
          }
        },
        "st4": {
          "type": "step",
          "settings": {
            "title": "Edit and delivery",
            "meta": "72 hours",
            "body": "<p>Cut, captions and export in every format you need, ready to upload to Meta or TikTok. Revisions included in your plan.</p>"
          }
        }
      },
      "block_order": [
        "st1",
        "st2",
        "st3",
        "st4"
      ]
    },
