<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#050508">
    <meta name="color-scheme" content="dark">
    <title>{{ shop.name }}</title>
    <meta name="description" content="{{ page_description | escape }}">

    {% render 'meta-tags' %}

    {% # theme-check-disable AssetPreload %}
    <link rel="preload" as="font" type="font/woff2" href="{{ 'clash-display-variable.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'satoshi-variable.woff2' | asset_url }}" crossorigin>
    {% # theme-check-enable AssetPreload %}

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body>
    <div class="grain" aria-hidden="true"></div>
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
