{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Cabecera compacta para páginas interiores (precios, portfolio, garantía, brief).
  Misma familia visual que el hero, un tercio de altura.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<section class="page-hero{% if s.show_gridlines %} gridlines{% endif %}">
  <span class="halo halo--tl" style="--halo-color: var(--c-violet); --halo-opacity: 0.32;" aria-hidden="true"></span>

  <div class="wrap page-hero__inner">
    {%- if s.eyebrow != blank -%}
      <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
    {%- endif -%}

    <h1 class="t-h1 page-hero__title" data-reveal style="--reveal-delay: 60ms">
      {{ s.heading | default: page.title }}
      {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
    </h1>

    {%- if s.body != blank -%}
      <p class="t-lead page-hero__body" data-reveal style="--reveal-delay: 120ms">{{ s.body }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="page-hero__pills" data-stagger="60">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }} data-reveal="fade">
            <span class="chip">
              <span class="chip__dot" aria-hidden="true"></span>
              {{ block.settings.text }}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cabecera de página",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta" },
    { "type": "text", "id": "heading", "label": "Titular", "info": "Si lo dejas vacío se usa el título de la página." },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada" },
    { "type": "textarea", "id": "body", "label": "Subtítulo" },
    { "type": "checkbox", "id": "show_gridlines", "label": "Rejilla de fondo", "default": true }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pastilla",
      "limit": 4,
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "[Dato de refuerzo]" }]
    }
  ],
  "presets": [{ "name": "Cabecera de página" }]
}
{% endschema %}
