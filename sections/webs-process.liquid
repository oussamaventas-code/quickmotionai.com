{{ 'qm-webs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section class="section qw-process">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>{{ s.heading }}</h2>
      {%- if s.body != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
      {%- endif -%}
    </div>

    <div class="qw-steps" data-stagger="110">
      <span class="qw-steps__line" data-draw aria-hidden="true"></span>

      {%- for block in section.blocks -%}
        <div class="qw-step" data-reveal {{ block.shopify_attributes }}>
          <span class="qw-step__dot" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="qw-step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="qw-step__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if s.cta_label != blank -%}
      <div class="btn-row" style="justify-content: center; margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);" data-reveal="fade">
        <a href="{{ s.cta_url | default: '#quiero-mi-web' }}" class="btn btn--primary btn--lg" data-qw-cta="click_starter" data-plan="starter">
          {{ s.cta_label }}
          {% render 'icon', name: 'arrow-right', size: 16 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Webs · Proceso",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Cómo funciona" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "De cero a tener web en 3 pasos." },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Sin reuniones eternas ni lenguaje técnico. Tú cuentas, nosotros hacemos." },
    { "type": "text", "id": "cta_label", "label": "Botón", "default": "Quiero mi web" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Nos cuentas qué necesitas." },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Un formulario corto o una conversación por WhatsApp. Nada más." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Proceso",
      "blocks": [
        { "type": "step", "settings": { "title": "Nos cuentas qué necesitas.", "text": "Un formulario corto o una conversación por WhatsApp. Nos dices qué haces y a quién quieres llegar." } },
        { "type": "step", "settings": { "title": "Nosotros creamos tu web.", "text": "Diseñamos, escribimos y montamos la página. Tú solo revisas y nos dices qué cambiar." } },
        { "type": "step", "settings": { "title": "Tu negocio empieza a tener presencia online.", "text": "Publicamos la web y te la dejamos lista para que tus clientes te encuentren y te escriban." } }
      ]
    }
  ]
}
{% endschema %}
