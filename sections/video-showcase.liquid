{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Escaparate de creativos. Es la sección que más pesa visualmente, así que sólo
  se cargan los vídeos que entran en pantalla (ver video-embed / video-player.js).

  Tres composiciones:
    strip   tira horizontal con ajuste por tarjeta (home)
    grid    rejilla de 3-4 columnas (portfolio)
    stagger rejilla escalonada, las pares bajan medio módulo (portfolio, más editorial)

  Filtros: la lista de la sección manda (para poder ordenarla) y cada creativo
  declara sus etiquetas. El filtrado es puramente de clase — nada se descarga ni
  se destruye al cambiar de pestaña, así que los vídeos ya cargados siguen ahí.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign layout = s.layout
  assign per_row = s.columns | default: 3
  assign filters = s.filters | split: ','
  assign show_filters = false
  if s.show_filters and filters.size > 0
    assign show_filters = true
  endif
-%}

<section class="section showcase showcase--{{ layout }}" {% if show_filters %}data-showcase-filter{% endif %}>
  {%- if s.show_halo -%}
    <span class="halo halo--bc" style="--halo-color: var(--c-violet); --halo-opacity: 0.16;" aria-hidden="true"></span>
  {%- endif -%}

  <div class="wrap">
    <div class="showcase__head section-head{% if s.align == 'center' %} section-head--center{% endif %}">
      {%- if s.eyebrow != blank -%}<p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="t-h2" data-reveal>
          {{ s.heading }}
          {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.body != blank -%}<p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>{%- endif -%}

      {%- if s.link_label != blank -%}
        <a href="{{ s.link_url }}" class="btn btn--text showcase__head-link" data-reveal="fade" style="--reveal-delay: 140ms">
          {{ s.link_label }}
          <span class="btn__arrow">{% render 'icon', name: 'arrow-right', size: 15 %}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if show_filters -%}
      <div class="showcase__filters" data-reveal="fade">
        <button type="button" class="showcase__filter is-active" data-filter="*" aria-pressed="true">
          {{ s.filter_all_label | default: 'All work' }}
        </button>
        {%- for filter in filters -%}
          {%- assign filter_label = filter | strip -%}
          {%- if filter_label != blank -%}
            <button type="button" class="showcase__filter" data-filter="{{ filter_label | downcase }}" aria-pressed="false">
              {{ filter_label }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- capture items -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign meta_parts = ''
        if block.settings.industry != blank
          assign meta_parts = meta_parts | append: block.settings.industry | append: '|'
        endif
        if block.settings.creative_type != blank
          assign meta_parts = meta_parts | append: block.settings.creative_type | append: '|'
        endif
        if block.settings.platform != blank
          assign meta_parts = meta_parts | append: block.settings.platform | append: '|'
        endif
        if block.settings.objective != blank
          assign meta_parts = meta_parts | append: block.settings.objective | append: '|'
        endif
        assign meta_list = meta_parts | split: '|'

        comment
          Las etiquetas de filtro salen del campo `tags` y, si está vacío, de los
          propios metadatos: una ficha bien rellenada ya filtra sin trabajo extra.
        endcomment
        assign tag_source = block.settings.tags
        if tag_source == blank
          assign tag_source = block.settings.industry | append: ',' | append: block.settings.creative_type
        endif
        assign tag_list = tag_source | downcase | split: ','
        assign tag_attr = ''
        for tag in tag_list
          assign clean_tag = tag | strip
          if clean_tag != blank
            assign tag_attr = tag_attr | append: '|' | append: clean_tag
          endif
        endfor
        if tag_attr != blank
          assign tag_attr = tag_attr | append: '|'
        endif
      -%}
      <figure class="showcase__item" {{ block.shopify_attributes }} data-reveal="scale" data-tags="{{ tag_attr }}">
        {% render 'video-embed',
          video: block.settings.video,
          video_url: block.settings.video_url,
          poster: block.settings.poster,
          poster_url: block.settings.poster_url,
          ratio: '9-16',
          lightbox: true,
          caption: block.settings.caption,
          m1_value: block.settings.metric_1_value,
          m1_label: block.settings.metric_1_label,
          m2_value: block.settings.metric_2_value,
          m2_label: block.settings.metric_2_label,
          m_color: block.settings.metric_color,
          class: 'vframe--lift vframe--hoverzoom',
          sizes: '(max-width: 749px) 88vw, (max-width: 989px) 44vw, 300px'
        %}

        {%- if meta_list.size > 0 -%}
          <figcaption class="showcase__meta">
            {%- for part in meta_list -%}
              <span class="showcase__meta-item">{{ part }}</span>
            {%- endfor -%}
          </figcaption>
        {%- endif -%}

        {%- if block.settings.note != blank -%}
          <figcaption class="showcase__note t-sm t-dim">{{ block.settings.note }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if layout == 'strip' -%}
    <div class="hscroll showcase__strip" data-stagger="70">{{ items }}</div>
  {%- else -%}
    <div class="wrap">
      <div class="showcase__grid showcase__grid--{{ per_row }}" data-stagger="80">{{ items }}</div>
    </div>
  {%- endif -%}

  {%- if show_filters -%}
    <div class="wrap">
      <p class="showcase__empty t-dim" hidden>{{ s.empty_text | default: 'Nothing in this category yet.' }}</p>
    </div>
  {%- endif -%}
</section>

{%- if show_filters -%}
  <script>
    (function () {
      var root = document.currentScript.previousElementSibling;
      if (!root || !root.hasAttribute('data-showcase-filter')) return;

      var buttons = root.querySelectorAll('.showcase__filter');
      var items = root.querySelectorAll('.showcase__item');
      var empty = root.querySelector('.showcase__empty');

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          var filter = button.dataset.filter;
          var shown = 0;

          buttons.forEach(function (other) {
            var active = other === button;
            other.classList.toggle('is-active', active);
            other.setAttribute('aria-pressed', active ? 'true' : 'false');
          });

          items.forEach(function (item) {
            var tags = item.dataset.tags || '';
            var match = filter === '*' || tags.indexOf('|' + filter + '|') !== -1;
            item.hidden = !match;
            if (match) shown++;
          });

          if (empty) empty.hidden = shown > 0;
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Escaparate de creativos",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Composición",
      "options": [
        { "value": "strip", "label": "Tira horizontal" },
        { "value": "grid", "label": "Rejilla" },
        { "value": "stagger", "label": "Rejilla escalonada" }
      ],
      "default": "strip"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas (sólo rejilla)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "header", "content": "Cabecera" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Trabajo real" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Creativos que" },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada", "default": "ya están gastando presupuesto" },
    { "type": "textarea", "id": "body", "label": "Subtítulo" },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación de la cabecera",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "link_label", "label": "Enlace de la cabecera", "default": "See the full portfolio" },
    { "type": "url", "id": "link_url", "label": "URL del enlace" },
    { "type": "checkbox", "id": "show_halo", "label": "Resplandor de fondo", "default": true },
    { "type": "header", "content": "Filtros" },
    { "type": "checkbox", "id": "show_filters", "label": "Mostrar filtros", "default": false },
    { "type": "text", "id": "filter_all_label", "label": "Etiqueta de todo", "default": "All work" },
    {
      "type": "textarea",
      "id": "filters",
      "label": "Filtros disponibles",
      "info": "Separados por comas y en el orden en que quieres verlos. Un creativo aparece si una de sus etiquetas coincide.",
      "default": "E-commerce, UGC, Healthcare, Wellness, Product ads, AI commercials, Image-to-video"
    },
    { "type": "text", "id": "empty_text", "label": "Texto si no hay resultados", "default": "Nothing in this category yet." }
  ],
  "blocks": [
    {
      "type": "creative",
      "name": "Creativo",
      "limit": 24,
      "settings": [
        { "type": "video", "id": "video", "label": "Vídeo" },
        { "type": "text", "id": "video_url", "label": "URL de vídeo externo (.mp4)" },
        { "type": "image_picker", "id": "poster", "label": "Póster" },
        { "type": "text", "id": "poster_url", "label": "URL de póster externo", "info": "Se usa solo si el vídeo viene de una URL externa y no tiene póster." },
        { "type": "text", "id": "caption", "label": "Pie sobre el vídeo" },
        { "type": "header", "content": "Ficha del creativo" },
        { "type": "text", "id": "industry", "label": "Sector", "info": "Ej.: Healthcare" },
        { "type": "text", "id": "creative_type", "label": "Tipo de creativo", "info": "Ej.: AI product explainer" },
        { "type": "text", "id": "platform", "label": "Plataforma", "info": "Ej.: Meta Ads" },
        { "type": "text", "id": "objective", "label": "Objetivo", "info": "Ej.: Product education" },
        { "type": "text", "id": "tags", "label": "Etiquetas de filtro", "info": "Separadas por comas. Si lo dejas vacío se usan el sector y el tipo de creativo." },
        { "type": "header", "content": "Métricas" },
        { "type": "text", "id": "metric_1_value", "label": "Métrica 1" },
        { "type": "text", "id": "metric_1_label", "label": "Etiqueta 1" },
        { "type": "text", "id": "metric_2_value", "label": "Métrica 2" },
        { "type": "text", "id": "metric_2_label", "label": "Etiqueta 2" },
        {
          "type": "select",
          "id": "metric_color",
          "label": "Color",
          "options": [
            { "value": "green", "label": "Verde" },
            { "value": "cyan", "label": "Cian" },
            { "value": "violet", "label": "Violeta" }
          ],
          "default": "green"
        },
        { "type": "text", "id": "note", "label": "Nota bajo el vídeo", "info": "Contexto corto. Ej.: 30 días · Meta Advantage+" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Escaparate de creativos",
      "blocks": [
        { "type": "creative" }, { "type": "creative" }, { "type": "creative" },
        { "type": "creative" }, { "type": "creative" }
      ]
    }
  ]
}
{% endschema %}
