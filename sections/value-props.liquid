{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign cols = section.blocks.size
  if cols > 4
    assign cols = 4
  endif
-%}

<section class="section value-props" id="{{ section.id }}">
  <div class="wrap">
    <div class="section-head{% if s.align == 'center' %} section-head--center{% endif %}">
      {%- if s.eyebrow != blank -%}<p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="t-h2" data-reveal>
          {{ s.heading }}
          {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.body != blank -%}<p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>{%- endif -%}
    </div>

    <div class="grid grid--{{ cols }}" data-stagger="80">
      {%- for block in section.blocks -%}
        <article class="card card--glow value-props__card" {{ block.shopify_attributes }} data-reveal>
          <span class="card__rule" aria-hidden="true"></span>
          {%- if block.settings.icon != 'none' -%}
            <span class="card__icon card__icon--{{ block.settings.icon_color }}">
              {% render 'icon', name: block.settings.icon, size: 20 %}
            </span>
          {%- endif -%}
          <h3 class="card__title">{{ block.settings.title }}</h3>
          <div class="card__text rte">{{ block.settings.body }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Propuestas de valor",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Por qué nosotros" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Un equipo creativo entero," },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada", "default": "por menos de lo que cuesta un freelance" },
    { "type": "textarea", "id": "body", "label": "Subtítulo" },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación de la cabecera",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Propuesta",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "bolt", "label": "Rayo" },
            { "value": "target", "label": "Diana" },
            { "value": "layers", "label": "Capas" },
            { "value": "clock", "label": "Reloj" },
            { "value": "refresh", "label": "Ciclo" },
            { "value": "sparkle", "label": "Destello" },
            { "value": "shield", "label": "Escudo" },
            { "value": "grid", "label": "Cuadrícula" },
            { "value": "video", "label": "Vídeo" },
            { "value": "none", "label": "Sin icono" }
          ],
          "default": "bolt"
        },
        {
          "type": "select",
          "id": "icon_color",
          "label": "Color del icono",
          "options": [
            { "value": "violet", "label": "Violeta" },
            { "value": "green", "label": "Verde" },
            { "value": "cyan", "label": "Cian" }
          ],
          "default": "violet"
        },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "richtext", "id": "body", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Propuestas de valor",
      "blocks": [
        { "type": "prop", "settings": { "icon": "bolt", "icon_color": "violet" } },
        { "type": "prop", "settings": { "icon": "target", "icon_color": "cyan" } },
        { "type": "prop", "settings": { "icon": "refresh", "icon_color": "green" } }
      ]
    }
  ]
}
{% endschema %}
