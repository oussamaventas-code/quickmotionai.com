{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Tabla comparativa. Cada bloque es una fila; las columnas se configuran en los
  ajustes de la sección para que la cabecera y las filas no se puedan desincronizar.
  En móvil la tabla hace scroll horizontal dentro de su propio contenedor.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cols = s.columns | split: ','
-%}

<section class="section compare">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}<p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="t-h2" data-reveal>
          {{ s.heading }}
          {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.body != blank -%}<p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>{%- endif -%}
    </div>

    <div class="ctable-scroll" data-reveal>
      <table class="ctable">
        <thead>
          <tr>
            <th scope="col">{{ s.row_header | default: '' }}</th>
            {%- for col in cols -%}
              {%- assign label = col | strip -%}
              <th scope="col" class="{% if forloop.index0 == s.highlight_index %}is-ours{% endif %}">{{ label }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              {%- assign values = block.settings.values | split: ',' -%}
              {%- for col in cols -%}
                {%- liquid
                  assign raw = values[forloop.index0] | default: '' | strip
                  assign is_ours = false
                  if forloop.index0 == s.highlight_index
                    assign is_ours = true
                  endif
                -%}
                <td class="{% if is_ours %}is-ours{% endif %}">
                  {%- if raw == 'si' or raw == 'sí' or raw == 'yes' -%}
                    <span class="tick tick--yes">{% render 'icon', name: 'check', size: 10 %}</span>
                    <span class="visually-hidden">{{ 'general.yes' | t }}</span>
                  {%- elsif raw == 'no' -%}
                    <span class="tick tick--no">{% render 'icon', name: 'close', size: 10 %}</span>
                    <span class="visually-hidden">{{ 'general.no' | t }}</span>
                  {%- else -%}
                    {{ raw }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tabla comparativa",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Comparativa" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Lo mismo que una agencia," },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada", "default": "sin los plazos ni la factura" },
    { "type": "textarea", "id": "body", "label": "Subtítulo" },
    { "type": "text", "id": "row_header", "label": "Cabecera de la primera columna" },
    {
      "type": "text",
      "id": "columns",
      "label": "Columnas",
      "info": "Separadas por comas, en orden.",
      "default": "Nosotros, Agencia tradicional, Freelance, Equipo interno"
    },
    {
      "type": "range",
      "id": "highlight_index",
      "label": "Columna destacada",
      "info": "0 = la primera columna de datos.",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "label", "label": "Concepto", "default": "[Concepto]" },
        {
          "type": "text",
          "id": "values",
          "label": "Valores",
          "info": "Separados por comas, en el mismo orden que las columnas. Escribe \"si\" o \"no\" para mostrar un icono.",
          "default": "si, no, no, no"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabla comparativa",
      "blocks": [
        { "type": "row", "settings": { "label": "Plazo de entrega", "values": "72 h, 3-4 semanas, 1-2 semanas, Variable" } },
        { "type": "row", "settings": { "label": "Coste mensual", "values": "[€], [€€€€], [€€], [€€€]" } },
        { "type": "row", "settings": { "label": "Volumen fijo garantizado", "values": "si, no, no, no" } },
        { "type": "row", "settings": { "label": "Revisiones incluidas", "values": "si, si, no, si" } },
        { "type": "row", "settings": { "label": "Sin permanencia", "values": "si, no, si, no" } }
      ]
    }
  ]
}
{% endschema %}
