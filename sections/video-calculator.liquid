{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Calculadora de vídeos sueltos (sin suscripción). Para quien no quiere pagar
  mensualidad: elige cuántos vídeos quiere con un stepper +/- y ve el total en
  vivo. Si esa cantidad sale más cara que un pack mensual equivalente (o igual
  de barata pero con más vídeos incluidos), se lo decimos con un aviso — no hay
  tope fijo en el stepper, el aviso es la única "barrera".

  El precio por vídeo sale del producto de compra única de Shopify (no se
  hardcodea aquí), y los packs de la comparación sacan su precio de sus propios
  productos también, así nunca hay números duplicados que puedan desincronizarse
  (es el mismo motivo por el que la sección de "savings" quedó desfasada al
  cambiar de EUR a USD).
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign product = s.product
  if product == blank and s.product_handle != blank
    assign product = all_products[s.product_handle]
  endif
  assign variant = product.selected_or_first_available_variant

  assign checkout_target = '/checkout'
  if s.go_to_cart
    assign checkout_target = routes.cart_url
  endif

  assign min_qty = s.min_qty | default: 1
  if min_qty < 1
    assign min_qty = 1
  endif
-%}

<section class="section vcalc">
  <span class="halo halo--tl" style="--halo-color: var(--c-cyan); --halo-opacity: 0.18;" aria-hidden="true"></span>

  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}<p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="t-h2" data-reveal>
          {{ s.heading }}
          {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.body != blank -%}<p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>{%- endif -%}
    </div>

    {%- if product != blank and variant != blank -%}
      <div
        class="vcalc__card"
        data-reveal
        data-vcalc
        data-price-cents="{{ variant.price }}"
        data-currency="{{ cart.currency.iso_code }}"
        data-min-qty="{{ min_qty }}"
      >
        <script type="application/json" data-vcalc-packs>
          [
            {%- for block in section.blocks -%}
              {%- if block.type == 'pack' -%}
                {%- liquid
                  assign pp = block.settings.product
                  if pp == blank and block.settings.product_handle != blank
                    assign pp = all_products[block.settings.product_handle]
                  endif
                  assign pv = pp.selected_or_first_available_variant
                -%}
                {%- if pp != blank and pv != blank -%}
                  {
                    "name": {{ block.settings.name | default: pp.title | json }},
                    "videos": {{ block.settings.videos | default: 0 }},
                    "price": {{ pv.price | default: 0 }},
                    "url": {{ pp.url | json }}
                  }{% unless forloop.last %},{% endunless %}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        </script>

        <div class="vcalc__unit">
          <span class="vcalc__unit-label">{{ s.unit_label | default: 'Price per video' }}</span>
          <span class="vcalc__unit-price">{{ variant.price | money }}</span>
        </div>

        <div class="vcalc__stepper" role="group" aria-label="{{ s.qty_label | default: 'Number of videos' }}">
          <button type="button" class="vcalc__stepper-btn" data-vcalc-minus aria-label="{{ 'general.minus' | t | default: 'Decrease' }}">−</button>
          <span class="vcalc__count" data-vcalc-qty>{{ min_qty }}</span>
          <button type="button" class="vcalc__stepper-btn" data-vcalc-plus aria-label="{{ 'general.plus' | t | default: 'Increase' }}">+</button>
        </div>
        <p class="vcalc__qty-label">{{ s.qty_label | default: 'videos, one-time purchase' }}</p>

        <div class="vcalc__total">
          <span class="vcalc__total-label">{{ s.total_label | default: 'Total' }}</span>
          <span class="vcalc__total-amount" data-vcalc-total>{{ variant.price | times: min_qty | money }}</span>
        </div>

        <p class="vcalc__nudge" data-vcalc-nudge hidden></p>

        {%- if variant.available -%}
          <form method="post" action="{{ routes.cart_add_url }}" id="vcalc-form-{{ section.id }}" class="vcalc__form" data-vcalc-form>
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="{{ min_qty }}" data-vcalc-quantity-input>
            <input type="hidden" name="return_to" value="{{ checkout_target }}">
            <button type="submit" class="btn btn--primary btn--lg btn--full">
              {{ s.cta_label | default: 'Buy these videos' }}
              {% render 'icon', name: 'arrow-right', size: 16 %}
            </button>
          </form>
        {%- else -%}
          <button type="button" class="btn btn--ghost btn--lg btn--full" disabled>{{ 'products.product.sold_out' | t }}</button>
        {%- endif -%}

        {%- if s.footer_note != blank -%}
          <p class="vcalc__footer-note t-sm t-dim">{{ s.footer_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-vcalc]').forEach(function (root) {
      var pricePerUnit = parseInt(root.dataset.priceCents, 10) || 0;
      var minQty = parseInt(root.dataset.minQty, 10) || 1;
      var currency = root.dataset.currency || 'USD';
      var qty = minQty;

      var packsEl = root.querySelector('[data-vcalc-packs]');
      var packs = [];
      try { packs = JSON.parse(packsEl ? packsEl.textContent : '[]'); } catch (e) { packs = []; }

      var qtyEl = root.querySelector('[data-vcalc-qty]');
      var totalEl = root.querySelector('[data-vcalc-total]');
      var nudgeEl = root.querySelector('[data-vcalc-nudge]');
      var quantityInput = root.querySelector('[data-vcalc-quantity-input]');
      var minusBtn = root.querySelector('[data-vcalc-minus]');
      var plusBtn = root.querySelector('[data-vcalc-plus]');

      function formatMoney(cents) {
        try {
          return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(cents / 100);
        } catch (e) {
          return '$' + (cents / 100).toFixed(2);
        }
      }

      function bestPackFor(qty, oneOffTotalCents) {
        // Any pack that covers at least `qty` videos and costs less than (or
        // the same as) buying them one by one is worth suggesting. Among
        // those, the cheapest one is the best nudge.
        var candidates = packs.filter(function (p) {
          return p.videos >= qty && p.price <= oneOffTotalCents;
        });
        if (!candidates.length) return null;
        candidates.sort(function (a, b) { return a.price - b.price; });
        return candidates[0];
      }

      function render() {
        var totalCents = pricePerUnit * qty;
        if (qtyEl) qtyEl.textContent = qty;
        if (totalEl) totalEl.textContent = formatMoney(totalCents);
        if (quantityInput) quantityInput.value = qty;

        var pack = bestPackFor(qty, totalCents);
        if (nudgeEl) {
          if (pack) {
            var savings = totalCents - pack.price;
            nudgeEl.innerHTML = 'Get ' + pack.videos + ' videos/mo on the <strong>' + pack.name +
              '</strong> plan for ' + formatMoney(pack.price) +
              (savings > 0 ? ' — save ' + formatMoney(savings) : '') +
              ' instead of buying one by one. <a href="' + pack.url + '">See the plan</a>';
            nudgeEl.hidden = false;
          } else {
            nudgeEl.hidden = true;
            nudgeEl.innerHTML = '';
          }
        }
      }

      if (minusBtn) {
        minusBtn.addEventListener('click', function () {
          qty = Math.max(minQty, qty - 1);
          render();
        });
      }
      if (plusBtn) {
        plusBtn.addEventListener('click', function () {
          qty = qty + 1;
          render();
        });
      }

      render();
    });
  })();
</script>

{% schema %}
{
  "name": "Video calculator",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No subscription needed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just need a" },
    { "type": "text", "id": "heading_accent", "label": "Accent part", "default": "few videos?" },
    { "type": "textarea", "id": "body", "label": "Subheading", "default": "Buy single ad videos one at a time, no monthly plan required." },
    { "type": "product", "id": "product", "label": "Single-video product" },
    { "type": "text", "id": "product_handle", "label": "Product handle (fallback)", "default": "single-ad-video" },
    { "type": "text", "id": "unit_label", "label": "\"Price per video\" label" },
    { "type": "text", "id": "qty_label", "label": "Quantity caption (under the stepper)", "default": "videos, one-time purchase" },
    { "type": "text", "id": "total_label", "label": "\"Total\" label" },
    { "type": "number", "id": "min_qty", "label": "Minimum quantity", "default": 1 },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Buy these videos" },
    { "type": "checkbox", "id": "go_to_cart", "label": "Send to cart instead of checkout", "default": false },
    { "type": "text", "id": "footer_note", "label": "Note under the button", "default": "Digital service: no shipping. Delivered in 72h from your brief." }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Comparison plan",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Plan product" },
        { "type": "text", "id": "product_handle", "label": "Product handle (fallback)" },
        { "type": "text", "id": "name", "label": "Display name", "info": "Leave blank to use the product title." },
        { "type": "number", "id": "videos", "label": "Videos included per month", "default": 3 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video calculator",
      "blocks": [
        { "type": "pack", "settings": { "product_handle": "pack-starter-3-videos-anuncio-ia-mes", "name": "Starter", "videos": 3 } },
        { "type": "pack", "settings": { "product_handle": "pack-growth-5-videos-anuncio-ia-mes", "name": "Growth", "videos": 5 } },
        { "type": "pack", "settings": { "product_handle": "pack-scale-10-videos-anuncio-ia-mes", "name": "Scale", "videos": 10 } }
      ]
    }
  ]
}
{% endschema %}
