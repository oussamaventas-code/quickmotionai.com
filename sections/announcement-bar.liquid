{%- if section.settings.text != blank -%}
  <div class="announce">
    {%- if section.settings.url != blank -%}
      <a href="{{ section.settings.url }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Texto",
      "default": "We limit monthly production capacity to maintain fast turnaround and quality."
    },
    { "type": "url", "id": "url", "label": "Enlace" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
