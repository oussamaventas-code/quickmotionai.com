{{ 'sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'brief-form.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Brief post-compra.

  Usa el formulario `contact` nativo de Shopify: la respuesta llega al correo de
  la tienda y queda registrada, sin apps de por medio. Todos los campos van como
  contact[...] para que aparezcan con su etiqueta en el email.

  Shopify no permite adjuntar archivos en formularios nativos: las referencias y
  los assets se piden como enlaces (Drive, Dropbox, WeTransfer).

  El progreso se guarda en localStorage a medida que se escribe, así que cerrar
  la pestaña a mitad no obliga a empezar de cero.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign steps = section.blocks | where: 'type', 'step'
-%}

<section class="section brief">
  <span class="halo halo--tr" style="--halo-color: var(--c-cyan); --halo-opacity: 0.16;" aria-hidden="true"></span>

  <div class="wrap wrap--narrow">
    {%- form 'contact', class: 'brief__form', id: 'brief-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="brief__success" role="status">
          <span class="brief__success-icon">{% render 'icon', name: 'check', size: 26 %}</span>
          <h2 class="t-h2">{{ s.success_heading }}</h2>
          <div class="rte t-lead">{{ s.success_body }}</div>
          {%- if s.success_cta_label != blank -%}
            <a href="{{ s.success_cta_url | default: routes.root_url }}" class="btn btn--primary btn--lg">{{ s.success_cta_label }}</a>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="section-head">
          {%- if s.eyebrow != blank -%}<p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>{%- endif -%}
          <h2 class="t-h2" data-reveal>
            {{ s.heading }}
            {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
          </h2>
          {%- if s.body != blank -%}<p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>{%- endif -%}
        </div>

        <div class="brief__shell" data-brief data-storage-key="brief-{{ section.id }}">
          {%- comment -%} Progreso {%- endcomment -%}
          <div class="brief__progress" aria-hidden="true">
            <div class="brief__progress-bar"><span data-brief-bar></span></div>
            <p class="brief__progress-text">
              <span data-brief-current>1</span> / <span data-brief-total>{{ steps.size }}</span>
            </p>
          </div>

          {%- if form.errors -%}
            <div class="brief__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {%- for block in steps -%}
            <fieldset
              class="brief__step"
              data-brief-step="{{ forloop.index }}"
              {% unless forloop.first %}hidden{% endunless %}
              {{ block.shopify_attributes }}
            >
              <legend class="brief__step-legend">
                <span class="brief__step-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span>
                  <span class="brief__step-title">{{ block.settings.title }}</span>
                  {%- if block.settings.hint != blank -%}
                    <span class="brief__step-hint">{{ block.settings.hint }}</span>
                  {%- endif -%}
                </span>
              </legend>

              {%- assign fields = block.settings.fields | newline_to_br | split: '<br />' -%}
              {%- for raw in fields -%}
                {%- liquid
                  assign line = raw | strip_html | strip
                  if line == blank
                    continue
                  endif
                  assign parts = line | split: '|'
                  assign f_type = parts[0] | strip | downcase
                  assign f_label = parts[1] | strip
                  assign f_extra = parts[2] | strip
                  assign f_id = 'brief-' | append: block.id | append: '-' | append: forloop.index
                  assign f_name = 'contact[' | append: f_label | append: ']'
                  assign f_required = false
                  if f_type contains '*'
                    assign f_required = true
                    assign f_type = f_type | remove: '*'
                  endif
                -%}

                <div class="field" data-brief-field>
                  <label class="field__label" for="{{ f_id }}">
                    {{ f_label }}
                    {%- if f_required -%}<span class="field__req" aria-hidden="true">*</span>{%- endif -%}
                  </label>

                  {%- case f_type -%}
                    {%- when 'email' -%}
                      <input
                        type="email"
                        class="input"
                        id="{{ f_id }}"
                        name="contact[email]"
                        autocomplete="email"
                        placeholder="{{ f_extra }}"
                        value="{{ form.email }}"
                        {% if f_required %}required{% endif %}
                      >
                    {%- when 'textarea' -%}
                      <textarea
                        class="textarea"
                        id="{{ f_id }}"
                        name="{{ f_name }}"
                        rows="4"
                        placeholder="{{ f_extra }}"
                        {% if f_required %}required{% endif %}
                      ></textarea>
                    {%- when 'url' -%}
                      <input
                        type="url"
                        class="input"
                        id="{{ f_id }}"
                        name="{{ f_name }}"
                        inputmode="url"
                        placeholder="{{ f_extra | default: 'https://' }}"
                        {% if f_required %}required{% endif %}
                      >
                    {%- when 'select' -%}
                      <select class="select" id="{{ f_id }}" name="{{ f_name }}" {% if f_required %}required{% endif %}>
                        <option value="">{{ 'general.choose' | t }}</option>
                        {%- assign options = f_extra | split: ';' -%}
                        {%- for option in options -%}
                          <option value="{{ option | strip }}">{{ option | strip }}</option>
                        {%- endfor -%}
                      </select>
                    {%- when 'pills' -%}
                      <div class="pillset" role="group" aria-labelledby="{{ f_id }}">
                        {%- assign options = f_extra | split: ';' -%}
                        {%- for option in options -%}
                          <label class="pill">
                            <input type="radio" name="{{ f_name }}" value="{{ option | strip }}">
                            <span>{{ option | strip }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <input
                        type="text"
                        class="input"
                        id="{{ f_id }}"
                        name="{{ f_name }}"
                        placeholder="{{ f_extra }}"
                        {% if f_required %}required{% endif %}
                      >
                  {%- endcase -%}

                  <span class="field__error" data-brief-error>{{ 'contact.form.required' | t }}</span>
                </div>
              {%- endfor -%}
            </fieldset>
          {%- endfor -%}

          <div class="brief__nav">
            <button type="button" class="btn btn--ghost" data-brief-prev hidden>
              {{ 'general.back' | t }}
            </button>
            <button type="button" class="btn btn--primary" data-brief-next>
              {{ s.next_label }}
              {% render 'icon', name: 'arrow-right', size: 15 %}
            </button>
            <button type="submit" class="btn btn--primary" data-brief-submit hidden>
              {{ s.submit_label }}
              {% render 'icon', name: 'check', size: 15 %}
            </button>
          </div>

          {%- if s.footer_note != blank -%}
            <p class="brief__note t-sm t-dim">{{ s.footer_note }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulario de brief",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Paso final" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Cuéntanos qué" },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada", "default": "vamos a vender" },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "[Cuanto más concreto sea el brief, menos rondas de revisión hacen falta. Tardas unos 10 minutos.]" },
    { "type": "text", "id": "next_label", "label": "Botón siguiente", "default": "Siguiente" },
    { "type": "text", "id": "submit_label", "label": "Botón de envío", "default": "Enviar brief" },
    { "type": "text", "id": "footer_note", "label": "Nota al pie", "default": "[Las referencias y los assets se envían como enlaces (Drive, Dropbox, WeTransfer).]" },
    { "type": "header", "content": "Pantalla de confirmación" },
    { "type": "text", "id": "success_heading", "label": "Titular", "default": "Brief recibido" },
    { "type": "richtext", "id": "success_body", "label": "Texto", "default": "<p>[Confirma el plazo y el siguiente paso: cuándo recibirán el primer lote y por qué canal.]</p>" },
    { "type": "text", "id": "success_cta_label", "label": "Botón", "default": "Volver al inicio" },
    { "type": "url", "id": "success_cta_url", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Título del paso", "default": "[Título]" },
        { "type": "text", "id": "hint", "label": "Ayuda" },
        {
          "type": "textarea",
          "id": "fields",
          "label": "Campos",
          "info": "Una línea por campo con el formato: tipo | Etiqueta | extra. Tipos: text, email, url, textarea, select, pills. Añade * al tipo para hacerlo obligatorio (ej. text*). En select y pills, separa las opciones con punto y coma.",
          "default": "email* | Email | tu@agencia.com\ntext* | Número de pedido | #1001"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Formulario de brief",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Tus datos",
            "hint": "Para vincular el brief con tu pedido",
            "fields": "email* | Email | tu@agencia.com\ntext* | Numero de pedido | #1001\ntext | Marca o cliente final | "
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "El producto",
            "hint": "Qué vamos a anunciar",
            "fields": "text* | Producto | \nurl | URL del producto | https://\ntextarea* | Que hace y por que es mejor | Tres frases bastan"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "El ángulo",
            "hint": "A quién le hablamos y cómo",
            "fields": "textarea* | Publico objetivo | Edad, contexto, que le preocupa\ntextarea* | Angulo de venta | El argumento principal que quieres probar\npills | Tono | Directo; Aspiracional; Humor; Testimonial; Educativo\ntext | Llamada a la accion | Compra ahora"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Referencias y assets",
            "hint": "Enlaces, no archivos",
            "fields": "textarea | Anuncios de referencia | Pega aqui los enlaces, uno por linea\nurl | Carpeta con tus assets | https://drive.google.com/...\ntextarea | Restricciones | Palabras prohibidas, claims que no podemos hacer, guia de marca"
          }
        }
      ]
    }
  ]
}
{% endschema %}
