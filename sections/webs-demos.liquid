{{ 'qm-webs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'qm-webs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<section class="section qw-demos" id="demos">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>{{ s.heading }}</h2>
      {%- if s.body != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
      {%- endif -%}
    </div>

    <div data-qw-demos data-reveal="fade">
      <div class="qw-demos__tabs" role="tablist" aria-label="{{ s.tablist_label | escape }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <button
            type="button"
            role="tab"
            id="demo-tab-{{ block.id }}"
            aria-controls="demo-panel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            class="qw-demos__tab"
            data-sector="{{ b.kind }}"
            {{ block.shopify_attributes }}
          >
            {%- case b.kind -%}
              {%- when 'peluqueria' or 'unas' or 'estetica' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6.5" r="2.6"/><circle cx="6" cy="17.5" r="2.6"/><path d="M8.3 7.9 20 17M8.3 16.1 20 7"/></svg>
              {%- when 'taller' or 'electricista' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.6 3.6a5.4 5.4 0 0 0-7 7L4 15.2a2.3 2.3 0 1 0 3.3 3.3l4.6-4.6a5.4 5.4 0 0 0 7-7l-2.9 2.9-2.8-.6-.6-2.8 2.9-2.9Z"/></svg>
              {%- when 'restaurante' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3v8.5a2.5 2.5 0 0 0 5 0V3M8.5 11.5V21M17 3c-1.4 1.4-2 3.2-2 5.5s.6 3.6 2 4.5V21"/></svg>
              {%- when 'inmobiliaria' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 10.5 8.5-6.8 8.5 6.8"/><path d="M5.8 12.2V20h12.4v-7.8"/><path d="M10 20v-4.6h4V20"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s7-4.6 7-9.6a7 7 0 1 0-14 0c0 5 7 9.6 7 9.6Z"/><path d="M9.4 10.6h5.2M12 8v5.2"/></svg>
            {%- endcase -%}
            {{ b.label }}
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div
          class="qw-demos__panel{% if forloop.first %} is-active{% endif %}"
          id="demo-panel-{{ block.id }}"
          role="tabpanel"
          aria-labelledby="demo-tab-{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="qw-demos__stage">
            <div class="qw-demos__frame">
              {% render 'webs-mockup', kind: b.kind, image: b.image %}
            </div>

            <div class="qw-demos__aside">
              <p class="qw-demos__sector">{{ b.title | default: b.label }}</p>
              {%- if b.desc != blank -%}
                <p class="qw-demos__desc">{{ b.desc }}</p>
              {%- endif -%}
              <div class="btn-row">
                <a
                  href="{{ s.cta_url | default: '#quiero-mi-web' }}"
                  class="btn btn--primary"
                  data-qw-cta="click_demo"
                  data-plan="{{ b.plan_value | default: 'starter' }}"
                >
                  {{ s.cta_label }}
                  {% render 'icon', name: 'arrow-right', size: 15 %}
                </a>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if s.note != blank -%}
      <p class="t-sm t-dim" style="text-align: center; margin-top: var(--s-7);" data-reveal="fade">{{ s.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Webs · Demos por sector",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Ejemplos" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Así podría verse tu negocio." },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Elige tu sector y mira cómo quedaría tu web: servicios, precios, ubicación y un botón de WhatsApp siempre a la vista." },
    { "type": "text", "id": "tablist_label", "label": "Nombre de la lista de pestañas", "default": "Sectores" },
    { "type": "text", "id": "cta_label", "label": "Botón", "default": "Quiero una como esta" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón" },
    { "type": "textarea", "id": "note", "label": "Nota", "default": "Ejemplos de diseño creados por nosotros. Los negocios que aparecen son ficticios." }
  ],
  "blocks": [
    {
      "type": "demo",
      "name": "Sector",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre de la pestaña", "default": "Peluquería" },
        {
          "type": "select",
          "id": "kind",
          "label": "Maqueta",
          "options": [
            { "value": "peluqueria", "label": "Peluquería" },
            { "value": "estetica", "label": "Centro de estética" },
            { "value": "unas", "label": "Uñas" },
            { "value": "fisio", "label": "Fisioterapia" },
            { "value": "taller", "label": "Taller" },
            { "value": "restaurante", "label": "Restaurante" },
            { "value": "electricista", "label": "Electricista" },
            { "value": "inmobiliaria", "label": "Inmobiliaria" }
          ],
          "default": "peluqueria"
        },
        { "type": "text", "id": "title", "label": "Titular del lateral", "default": "Webs para peluquerías" },
        { "type": "textarea", "id": "desc", "label": "Descripción", "default": "Servicios con precio, horarios y reserva por WhatsApp. Lo que un cliente busca antes de decidirse." },
        { "type": "image_picker", "id": "image", "label": "Foto de la maqueta", "info": "Opcional. Da mucho realismo a la demo." },
        { "type": "text", "id": "plan_value", "label": "Plan preseleccionado", "default": "starter" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Demos por sector",
      "blocks": [
        { "type": "demo", "settings": { "label": "Peluquería", "kind": "peluqueria", "title": "Webs para peluquerías", "desc": "Servicios con precio, horarios y reserva por WhatsApp. Lo que un cliente busca antes de decidirse." } },
        { "type": "demo", "settings": { "label": "Taller", "kind": "taller", "title": "Webs para talleres", "desc": "Servicios, presupuesto cerrado y teléfono a un toque. El cliente llama sin dar vueltas." } },
        { "type": "demo", "settings": { "label": "Restaurante", "kind": "restaurante", "title": "Webs para restaurantes", "desc": "Carta, menú del día y reservas. Sin depender de que alguien conteste el teléfono." } },
        { "type": "demo", "settings": { "label": "Fisioterapia", "kind": "fisio", "title": "Webs para fisioterapia", "desc": "Tratamientos, bonos y petición de cita. Con la información que da confianza antes de la primera sesión." } },
        { "type": "demo", "settings": { "label": "Centro de estética", "kind": "estetica", "title": "Webs para centros de estética", "desc": "Tratamientos con precio, galería y cita previa. Tu escaparate abierto las 24 horas." } }
      ]
    }
  ]
}
{% endschema %}
