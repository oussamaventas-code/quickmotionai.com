{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section class="closer" style="min-height: 100svh; display: flex; align-items: center; padding-block: var(--s-9);">
  <span class="halo halo--bc" style="--halo-color: var(--c-violet); --halo-opacity: 0.3;" aria-hidden="true"></span>

  <div class="wrap wrap--narrow closer__inner">
    <p class="chip chip--violet" data-reveal="fade">
      <span class="chip__dot chip__dot--pulse" aria-hidden="true"></span>
      {{ s.eyebrow }}
    </p>

    <h1 class="t-h1 closer__title" data-reveal style="--reveal-delay: 60ms">
      {{ s.heading }}
      {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
    </h1>

    {%- if s.body != blank -%}
      <p class="t-lead closer__body" data-reveal style="--reveal-delay: 120ms">{{ s.body }}</p>
    {%- endif -%}

    {%- if shop.password_message != blank -%}
      <div class="rte closer__body" data-reveal style="--reveal-delay: 140ms">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'brief__form' -%}
      <div class="field" data-reveal="fade" style="max-width: 360px; margin-inline: auto; text-align: left; --reveal-delay: 200ms">
        <label class="field__label" for="Password">{{ 'general.password_page.password_placeholder' | t }}</label>
        <div class="btn-row" style="flex-wrap: nowrap;">
          <input type="password" class="input" id="Password" name="password" placeholder="{{ 'general.password_page.password_placeholder' | t }}">
          <button type="submit" class="btn btn--primary">{{ 'general.password_page.enter_password' | t }}</button>
        </div>
        {%- if form.errors -%}
          <span class="field__error" style="display:block;">{{ 'general.password_page.login_form_error' | t }}</span>
        {%- endif -%}
      </div>
    {%- endform -%}

    {%- if s.admin_note != blank -%}
      <p class="t-sm t-dim closer__note" data-reveal="fade">
        <a href="/admin" style="text-decoration: underline;">{{ s.admin_note }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Página de contraseña",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Próximamente" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Estamos produciendo" },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada", "default": "algo nuevo" },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Vídeos-anuncio con IA para agencias. Muy pronto." },
    { "type": "text", "id": "admin_note", "label": "Enlace de acceso admin", "default": "Entrar con contraseña de tienda" }
  ]
}
{% endschema %}
