{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section class="section section--tight guarantee">
  <div class="wrap">
    <div class="guarantee__card" data-reveal>
      <span class="guarantee__glow" aria-hidden="true"></span>

      <div class="guarantee__icon" aria-hidden="true">
        {% render 'icon', name: 'shield', size: 26 %}
      </div>

      <div class="guarantee__body">
        {%- if s.eyebrow != blank -%}
          <p class="t-label t-label--plain guarantee__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        <h2 class="t-h3 guarantee__title">{{ s.heading }}</h2>
        <div class="rte guarantee__text">{{ s.body }}</div>
      </div>

      {%- if s.cta_label != blank -%}
        <div class="guarantee__cta">
          <a href="{{ s.cta_url }}" class="btn btn--ghost">
            {{ s.cta_label }}
            {% render 'icon', name: 'arrow-right', size: 15 %}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="guarantee__points" data-stagger="70">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }} data-reveal="fade">
            <span class="tick tick--yes" aria-hidden="true">{% render 'icon', name: 'check', size: 10 %}</span>
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Garantía",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Garantía" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "[Titular de la garantía. Ej.: Si el primer lote no te convence, te devolvemos el mes]" },
    { "type": "richtext", "id": "body", "label": "Texto", "default": "<p>[Condiciones exactas: en cuántos días, qué hay que hacer para reclamarla y qué se devuelve. Cuanto más concreto, más convierte.]</p>" },
    { "type": "text", "id": "cta_label", "label": "Botón" },
    { "type": "url", "id": "cta_url", "label": "Enlace" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Punto",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "[Punto de refuerzo]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garantía",
      "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }]
    }
  ]
}
{% endschema %}
