{{ 'qm-webs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign results = section.blocks | where: 'type', 'result'
-%}

<section class="section qw-problem">
  <div class="wrap">
    <div class="qw-problem__inner">
      <div>
        <div class="section-head">
          {%- if s.eyebrow != blank -%}
            <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
          {%- endif -%}
          <h2 class="t-h2" data-reveal>{{ s.heading }}</h2>
        </div>

        <ul class="qw-problem__cards" data-stagger="80">
          {%- for block in section.blocks -%}
            {%- if block.type == 'pain' -%}
              <li class="qw-problem__card" data-reveal="left" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.2M12 16.3v.2"/></svg>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if s.body != blank -%}
          <p class="t-body qw-problem__body" data-reveal="fade">{{ s.body }}</p>
        {%- endif -%}
      </div>

      <div data-reveal="right" style="--reveal-delay: 120ms">
        <div class="qw-serp" aria-hidden="true">
          <div class="qw-serp__bar">
            <div class="qw-serp__field">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
              {{ s.query }}<span class="qw-serp__caret"></span>
            </div>
          </div>

          <div class="qw-serp__list">
            {%- for block in results -%}
              {%- assign b = block.settings -%}
              <div class="qw-serp__item{% if b.is_you %} qw-serp__item--you{% endif %}">
                <span class="qw-serp__avatar">{{ b.name | slice: 0 }}</span>
                <div>
                  <p class="qw-serp__name">{{ b.name }}</p>
                  <div class="qw-serp__meta">
                    <span class="qw-mock__stars">
                      {%- for i in (1..5) -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.6 2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.44 6.19 20.5l1.11-6.47L2.6 9.45l6.5-.95L12 2.6Z"/></svg>
                      {%- endfor -%}
                    </span>
                    {{ b.meta }}
                  </div>
                  <div class="qw-serp__links">
                    <span class="qw-serp__pill{% unless b.has_site %} qw-serp__pill--off{% endunless %}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M3.6 9.5h16.8M3.6 14.5h16.8"/><path d="M12 3.5c2 2.3 3.1 5.3 3.1 8.5s-1.1 6.2-3.1 8.5c-2-2.3-3.1-5.3-3.1-8.5S10 5.8 12 3.5Z"/></svg>
                      {% if b.has_site %}{{ b.site_label | default: 'Sitio web' }}{% else %}{{ s.no_site_label }}{% endif %}
                    </span>
                    <span class="qw-serp__pill">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.4"/></svg>
                      Cómo llegar
                    </span>
                  </div>
                </div>
                {%- if b.is_you -%}
                  <span class="qw-serp__flag">{{ s.you_label }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Webs · Problema",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "El punto de partida" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Tu cliente ya está buscando tu negocio." },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Hoy, cuando alguien descubre un negocio, lo primero que hace es buscarlo online. Una web profesional puede marcar la diferencia entre contactar contigo o irse a otro." },
    { "type": "header", "content": "Búsqueda simulada" },
    { "type": "text", "id": "query", "label": "Búsqueda", "default": "peluquería cerca de mí" },
    { "type": "text", "id": "no_site_label", "label": "Etiqueta cuando no hay web", "default": "Sin sitio web" },
    { "type": "text", "id": "you_label", "label": "Marca del negocio sin web", "default": "Tu negocio" }
  ],
  "blocks": [
    {
      "type": "pain",
      "name": "Situación",
      "limit": 4,
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "¿No tienes web?" }]
    },
    {
      "type": "result",
      "name": "Resultado de búsqueda",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre del negocio", "default": "Salón Aurora" },
        { "type": "text", "id": "meta", "label": "Línea de datos", "default": "4,9 · Peluquería · A 350 m" },
        { "type": "checkbox", "id": "has_site", "label": "Tiene sitio web", "default": true },
        { "type": "text", "id": "site_label", "label": "Texto del enlace web", "default": "Sitio web" },
        { "type": "checkbox", "id": "is_you", "label": "Es el negocio del visitante", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Problema",
      "blocks": [
        { "type": "pain", "settings": { "text": "¿No tienes web?" } },
        { "type": "pain", "settings": { "text": "¿Tu web está desactualizada?" } },
        { "type": "pain", "settings": { "text": "¿Solo tienes Instagram?" } },
        { "type": "result", "settings": { "name": "Salón Aurora", "meta": "4,9 · Peluquería · A 350 m", "has_site": true, "is_you": false } },
        { "type": "result", "settings": { "name": "Estudio Nou", "meta": "4,7 · Peluquería · A 600 m", "has_site": true, "is_you": false } },
        { "type": "result", "settings": { "name": "Tu peluquería", "meta": "4,8 · Peluquería · A 120 m", "has_site": false, "is_you": true } }
      ]
    }
  ]
}
{% endschema %}
