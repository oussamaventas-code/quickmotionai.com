{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Formatos que producimos. Cada tarjeta lleva su propio ejemplo real: el vídeo
  manda, el texto sólo lo nombra. Si un bloque aún no tiene vídeo, el marco cae
  en su placeholder y la tarjeta sigue siendo legible.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cats = section.blocks | where: 'type', 'category'
-%}

<section class="section caps">
  {%- if s.show_halo -%}
    <span class="halo halo--tr" style="--halo-color: var(--c-cyan); --halo-opacity: 0.14;" aria-hidden="true"></span>
  {%- endif -%}

  <div class="wrap">
    <div class="section-head{% if s.align == 'center' %} section-head--center{% endif %}">
      {%- if s.eyebrow != blank -%}<p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="t-h2" data-reveal>
          {{ s.heading }}
          {%- if s.heading_accent != blank -%}<span class="t-grad">{{ s.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.body != blank -%}<p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>{%- endif -%}
    </div>

    <div class="caps__grid caps__grid--{{ s.columns }}" data-stagger="80">
      {%- for block in cats -%}
        <article class="caps__card" {{ block.shopify_attributes }} data-reveal="scale">
          <div class="caps__media">
            {% render 'video-embed',
              video: block.settings.video,
              video_url: block.settings.video_url,
              poster: block.settings.poster,
              poster_url: block.settings.poster_url,
              ratio: '9-16',
              lightbox: true,
              caption: block.settings.caption,
              class: 'vframe--lift vframe--hoverzoom',
              sizes: '(max-width: 749px) 82vw, (max-width: 989px) 42vw, 300px'
            %}
          </div>
          <div class="caps__body">
            <h3 class="caps__title">{{ block.settings.title }}</h3>
            {%- if block.settings.body != blank -%}
              <p class="caps__text">{{ block.settings.body }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if s.cta_label != blank -%}
      <div class="caps__foot" data-reveal="fade">
        <a href="{{ s.cta_url | default: '/pages/portfolio' }}" class="btn btn--ghost btn--lg">
          {{ s.cta_label }}
          {% render 'icon', name: 'arrow-right', size: 15 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Qué producimos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "What we create" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Ad creatives built for" },
    { "type": "text", "id": "heading_accent", "label": "Parte destacada", "default": "modern performance marketing" },
    { "type": "textarea", "id": "body", "label": "Subtítulo" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación de la cabecera",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_halo", "label": "Resplandor de fondo", "default": true },
    { "type": "text", "id": "cta_label", "label": "Botón final" },
    { "type": "url", "id": "cta_url", "label": "URL del botón" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Formato",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "body", "label": "Texto" },
        { "type": "header", "content": "Ejemplo visual" },
        { "type": "video", "id": "video", "label": "Vídeo" },
        { "type": "text", "id": "video_url", "label": "URL de vídeo externo (.mp4)" },
        { "type": "image_picker", "id": "poster", "label": "Póster" },
        { "type": "text", "id": "poster_url", "label": "URL de póster externo" },
        { "type": "text", "id": "caption", "label": "Pie sobre el vídeo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Qué producimos",
      "blocks": [
        { "type": "category" }, { "type": "category" }, { "type": "category" },
        { "type": "category" }, { "type": "category" }, { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
