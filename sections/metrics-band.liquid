{{ 'sections.css' | asset_url | stylesheet_tag }}

<section class="section section--tight metrics">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        <h2 class="t-h3" data-reveal>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="metrics__grid metrics__grid--{{ section.blocks.size }}" data-stagger="90">
      {%- for block in section.blocks -%}
        <div class="metrics__item" {{ block.shopify_attributes }} data-reveal>
          <p class="t-metric metrics__value metrics__value--{{ block.settings.color }}">
            {%- if block.settings.prefix != blank -%}<span class="metrics__affix">{{ block.settings.prefix }}</span>{%- endif -%}
            {%- if block.settings.animate and block.settings.number != blank -%}
              <span data-count-to="{{ block.settings.number }}" data-count-decimals="{{ block.settings.decimals }}">0</span>
            {%- else -%}
              {{ block.settings.number }}
            {%- endif -%}
            {%- if block.settings.suffix != blank -%}<span class="metrics__affix">{{ block.settings.suffix }}</span>{%- endif -%}
          </p>
          <p class="metrics__label">{{ block.settings.label }}</p>
          {%- if block.settings.note != blank -%}
            <p class="metrics__note">{{ block.settings.note }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="metrics__disclaimer t-sm" data-reveal="fade">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cifras",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular" },
    { "type": "text", "id": "disclaimer", "label": "Nota al pie", "info": "Importante para que las cifras sean verificables: di de dónde salen." }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Cifra",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "prefix", "label": "Prefijo" },
        { "type": "text", "id": "number", "label": "Número", "default": "0" },
        { "type": "text", "id": "suffix", "label": "Sufijo" },
        { "type": "checkbox", "id": "animate", "label": "Animar el conteo", "default": true },
        { "type": "range", "id": "decimals", "label": "Decimales", "min": 0, "max": 2, "step": 1, "default": 0 },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Etiqueta" },
        { "type": "text", "id": "note", "label": "Nota" },
        { "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Verde" }, { "value": "cyan", "label": "Cian" }, { "value": "violet", "label": "Violeta" }, { "value": "plain", "label": "Blanco" }], "default": "plain" }
      ]
    }
  ],
  "presets": [{ "name": "Cifras", "blocks": [{ "type": "metric" }, { "type": "metric" }, { "type": "metric" }] }]
}
{% endschema %}
