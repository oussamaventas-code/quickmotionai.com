{%- comment -%}
  Sprite de iconos en línea. Trazo de 1.5, cuadrícula de 24, sin relleno:
  todos comparten peso óptico con la tipografía.

  Uso: {% render 'icon', name: 'arrow-right' %}
       {% render 'icon', name: 'play', size: 20, class: 'foo' %}
{%- endcomment -%}

{%- liquid
  assign s = size | default: 24
  assign extra = class | default: ''
-%}

{%- case name -%}
  {%- when 'arrow-right' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5"/></svg>

  {%- when 'arrow-up-right' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7m0 0H8.5M17 7v8.5"/></svg>

  {%- when 'arrow-down' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14m0 0 5.5-5.5M12 19l-5.5-5.5"/></svg>

  {%- when 'chevron-down' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 8.5 7 7 7-7"/></svg>

  {%- when 'play' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8.4 5.3a1 1 0 0 1 1.02.04l9 6a1 1 0 0 1 0 1.66l-9 6A1 1 0 0 1 7.9 18.3V5.7a1 1 0 0 1 .5-.4Z"/></svg>

  {%- when 'sound-on' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6.5 9H3v6h3.5L11 19V5Z"/><path d="M15 9.5a3.5 3.5 0 0 1 0 5M17.8 6.8a7 7 0 0 1 0 10.4"/></svg>

  {%- when 'sound-off' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6.5 9H3v6h3.5L11 19V5Z"/><path d="m16 10 5 4m0-4-5 4"/></svg>

  {%- when 'expand' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 4H4v5M15 4h5v5M15 20h5v-5M9 20H4v-5"/></svg>

  {%- when 'close' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"/></svg>

  {%- when 'check' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7"/></svg>

  {%- when 'minus' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 12h12"/></svg>

  {%- when 'plus' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 6v12M6 12h12"/></svg>

  {%- when 'cart' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4h2.2l1.9 10.4a1.6 1.6 0 0 0 1.6 1.3h7.9a1.6 1.6 0 0 0 1.6-1.3L20 7.6H6.1"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>

  {%- when 'sparkle' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.2 13.8 9 19.5 10.8 13.8 12.6 12 18.4 10.2 12.6 4.5 10.8 10.2 9 12 3.2Z"/><path d="M18.6 16.2 19.4 18.4 21.6 19.2 19.4 20 18.6 22.2 17.8 20 15.6 19.2 17.8 18.4 18.6 16.2Z"/></svg>

  {%- when 'bolt' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13.4 2.5 4.8 13.2h6L10.6 21.5 19.2 10.8h-6l.2-8.3Z"/></svg>

  {%- when 'target' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>

  {%- when 'layers' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 3 9 4.8-9 4.8-9-4.8L12 3Z"/><path d="m3.5 12.2 8.5 4.5 8.5-4.5M3.5 16.6l8.5 4.5 8.5-4.5"/></svg>

  {%- when 'clock' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.3l3.4 2"/></svg>

  {%- when 'refresh' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20.5 4v4.2h-4.2"/></svg>

  {%- when 'shield' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.8 4.8 5.7v5.6c0 4.3 2.9 8.2 7.2 9.9 4.3-1.7 7.2-5.6 7.2-9.9V5.7L12 2.8Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>

  {%- when 'globe' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M3.6 9.5h16.8M3.6 14.5h16.8"/><path d="M12 3.5c2 2.3 3.1 5.3 3.1 8.5s-1.1 6.2-3.1 8.5c-2-2.3-3.1-5.3-3.1-8.5S10 5.8 12 3.5Z"/></svg>

  {%- when 'video' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.8" y="5.5" width="13" height="13" rx="2.5"/><path d="m15.8 10.5 5.4-3v9l-5.4-3v-3Z"/></svg>

  {%- when 'chat' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.5 11.6c0 4-3.8 7.2-8.5 7.2a9.9 9.9 0 0 1-2.6-.34L4.2 20.5l1.3-3.6a6.9 6.9 0 0 1-2-4.7c0-4 3.8-7.2 8.5-7.2s8.5 3.2 8.5 7.2Z"/></svg>

  {%- when 'grid' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="7" height="7" rx="1.8"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.8"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.8"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.8"/></svg>

  {%- when 'menu' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg>

  {%- when 'external' -%}
    <svg class="icon {{ extra }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-8.5 8.5"/><path d="M18 14v4.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/></svg>
{%- endcase -%}
